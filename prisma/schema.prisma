// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Or "postgresql", "mysql", etc.
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  role  Role   @default(USER)
  cvs   Cv[]
}

model Skill {
  id          String @id @default(uuid())
  designation String @unique
  cvs         Cv[]   @relation("CvSkills") // Explicit many-to-many relation
}

model Cv {
  id     String  @id @default(uuid())
  name   String
  age    Int
  job    String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade) // Enforce user exists
  skills Skill[] @relation("CvSkills") // Explicit many-to-many relation

  // Add an index for quicker user lookups
  @@index([userId])
}

enum Role {
  ADMIN
  USER
}